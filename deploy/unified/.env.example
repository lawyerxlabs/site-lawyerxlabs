# Copy to .env (gitignored) and fill in. Names and comments only — never commit real values.
# Only Turnstile + auth bridge secrets are file-backed (see README "Secret files").
# AUTH_CLIENT_SECRET, AUTH_SESSION_SECRET, AUTH_BRIDGE_SECRET, PROXY_SECRET are plain container env
# from this file: visible via `docker inspect`. Keep .env chmod 600.

# ---- LawyerLab web (build args) ----
# Surface name baked into the SPA build. Default: lawyerlab.
VITE_SURFACE=
# Turnstile site key (public). Build fails if empty.
VITE_TURNSTILE_SITEKEY=

# ---- LawyerLab auth (auth-server) ----
# Shared bridge secret between auth and tool-parse-gateway. Must equal the content of AUTH_BRIDGE_SECRET_SOURCE_FILE.
AUTH_BRIDGE_SECRET=
# OIDC issuer URL (Logto).
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Session cookie signing secret.
AUTH_SESSION_SECRET=
# Allowed browser origins for auth CORS/redirects (comma-separated). Each frontend hostname must be listed here,
# including the Human Resources Lab hostname (hr-web) before it launches.
AUTH_ORIGINS=
# Optional: comma-separated roles required for access. Empty = default gate `lawyerlab-member,lawyerlab-admin`.
AUTH_REQUIRED_ROLES=

# ---- Tool Parse API ----
# Required. API rejects requests without it; gateway injects it.
PROXY_SECRET=
# Presidio analyzer base URL (http or https). Empty = default http://presidio:3000. Must answer GET /health 200.
PRESIDIO_ANALYZER_URL=
# Required. Name of an EXISTING internal Docker network the external Presidio analyzer (alias presidio) is on.
# Create: docker network create --internal <name>. up.sh refuses if not internal. See README.
PRESIDIO_NETWORK=
# Optional. Processing mode passthrough.
TOOL_PARSE_MODE=
# Optional. Upload size limits (bytes).
TOOL_PARSE_MEMBER_MAX_BYTES=
TOOL_PARSE_FREE_MAX_BYTES=
TOOL_PARSE_DOCX_MAX_UNCOMPRESSED_BYTES=
# Optional. Per-job timeout (ms).
TOOL_PARSE_JOB_TIMEOUT_MS=
# Optional. Daily quotas. Defaults in compose: anon 500, member 1000.
TOOL_PARSE_ANON_GLOBAL_DAILY=
TOOL_PARSE_MEMBER_DAILY=
# Optional. Retention (ms). Empty = app default.
TOOL_PARSE_RETENTION_MS=
TOOL_PARSE_FREE_RETENTION_MS=
# Optional. Isolated smoke runs only. Set to 1 to mock Turnstile/API. Never in production.
TOOL_PARSE_MOCK=

# ---- Tool Parse gateway ----
# Turnstile hostnames allowed to verify tokens (comma-separated). Required. Must include every frontend hostname,
# including the Human Resources Lab hostname (hr-web) before it launches.
TURNSTILE_ALLOWED_HOSTNAMES=
# Turnstile action name. Default: tool_parse_upload.
TURNSTILE_ACTION=
# Optional. Login/signup URLs shown by the gateway-served UI.
VITE_LOGIN_URL=
VITE_SIGNUP_URL=

# ---- Secret file host paths (read by Compose at `up`; contents never printed) ----
# Default: /etc/tool-parse/secrets/turnstile_secret
TURNSTILE_SECRET_SOURCE_FILE=
# Default: /etc/tool-parse/secrets/auth_bridge_secret
AUTH_BRIDGE_SECRET_SOURCE_FILE=
# Onboarding LLM provider for the tool-parse proxy: cloud (default), openrouter (ZDR) or local.
# TOOL_PARSE_ONBOARD_MODEL must be a model that provider serves. Takes effect on proxy recreate.
ONBOARD_LLM_PROVIDER=
# Key files for the selected provider only (required by up.sh; local needs none).
CLOUD_LLM_KEY_SOURCE_FILE=
OPENROUTER_KEY_SOURCE_FILE=
# URL overrides. Defaults: https://omni.romeshh.com/v1/chat/completions,
# https://openrouter.ai/api/v1/chat/completions, https://chat.tail713de8.ts.net/v1/chat/completions
CLOUD_LLM_URL=
OPENROUTER_URL=
LOCAL_LLM_URL=

# Waitlist -> Twenty CRM delivery (optional; unset = signups stay PENDING)
TWENTY_BASE_URL=
TWENTY_API_KEY=

# Onboarding generation (tool-parse /onboard/v1). Leave TOOL_PARSE_ONBOARD_MODEL empty to keep it off
# (503 llm_not_configured). Set to the omni alias only after site-lawyerlab#54 is resolved.
TOOL_PARSE_ONBOARD_MODEL=
# Personal-data handling mode and entities are set in tool-parse workflows/hr-onboarding/pii.js (ADR-005), not here.
